@page
@model UploadModel
@using ScholarHub.Web.Models
@{
    ViewData["Title"] = "Upload a Resource";
}

<h1 class="h3 mb-3">Upload a Resource</h1>
<p class="text-muted">Accepted formats: PDF, DOCX, PPTX (max 25 MB). Submissions are reviewed by an admin before they appear in the library.</p>

<form method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-8">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Type" class="form-label"></label>
        <select asp-for="Input.Type" class="form-select" asp-items="Html.GetEnumSelectList<ResourceType>()"></select>
        <span asp-validation-for="Input.Type" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Department" class="form-label"></label>
        <select asp-for="Input.Department" class="form-select">
            <option value="">Select a department</option>
            @foreach (var dept in Model.Departments)
            {
                <option value="@dept">@dept</option>
            }
        </select>
        <span asp-validation-for="Input.Department" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.CourseCode" class="form-label"></label>
        <input asp-for="Input.CourseCode" class="form-control" placeholder="e.g. CSCD201" />
        <span asp-validation-for="Input.CourseCode" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.AcademicYear" class="form-label"></label>
        <input asp-for="Input.AcademicYear" class="form-control" placeholder="2023/2024" />
        <span asp-validation-for="Input.AcademicYear" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Input.File" class="form-label"></label>
        <input asp-for="Input.File" type="file" class="form-control" accept=".pdf,.docx,.pptx" />
        <span asp-validation-for="Input.File" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Submit for review</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
