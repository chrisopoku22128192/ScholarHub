<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScholarHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ScholarHub.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-4 sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <svg class="sh-logo-mark" width="24" height="21" viewBox="0 0 26 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13 4C11 2 7 1 2 1V18C7 18 11 19 13 21C15 19 19 18 24 18V1C19 1 15 2 13 4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                        <path d="M13 4V21" stroke="currentColor" stroke-width="2" />
                    </svg>
                    ScholarHub
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-collection me-1"></i>Library</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    @{
        var requestPath = Context.Request.Path.Value ?? "";
        var isAuthShell = requestPath.Contains("/Account/Login", StringComparison.OrdinalIgnoreCase)
            || requestPath.Contains("/Account/Register", StringComparison.OrdinalIgnoreCase);
    }
    @if (isAuthShell)
    {
        <div class="container">
            <div class="sh-auth-shell">
                <div class="sh-auth-panel d-none d-md-flex">
                    <div class="sh-auth-illustration-wrap">
                        <div class="sh-illustration sh-illustration-lg">
                            <div class="sh-blob"></div>
                            <svg class="sh-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M50 28 L92 44 L50 60 L8 44 Z" fill="#FAF6EE" />
                                <path d="M24 51 V70 C24 76 36 80 50 80 C64 80 76 76 76 70 V51" stroke="#FAF6EE" stroke-width="4" fill="none" stroke-linecap="round" />
                                <line x1="92" y1="44" x2="92" y2="64" stroke="#FAF6EE" stroke-width="4" stroke-linecap="round" />
                                <circle cx="92" cy="67" r="3.5" fill="#232f7f" />
                            </svg>
                        </div>
                        <svg class="sh-doodle sh-doodle-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="12" y1="2" x2="12" y2="22" />
                            <line x1="4" y1="7" x2="20" y2="17" />
                            <line x1="20" y1="7" x2="4" y2="17" />
                        </svg>
                        <svg class="sh-doodle sh-doodle-squiggle" viewBox="0 0 100 50" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
                            <path d="M4 32C10 8 26 6 32 22C36 32 30 44 38 38C48 30 40 10 54 8C66 6 64 22 74 16C82 11 78 2 92 6" />
                        </svg>
                        <svg class="sh-doodle sh-doodle-diamond" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="4" y="4" width="16" height="16" transform="rotate(45 12 12)" />
                        </svg>
                        <svg class="sh-doodle sh-doodle-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="5" y1="5" x2="19" y2="19" />
                            <line x1="19" y1="5" x2="5" y2="19" />
                        </svg>
                    </div>
                    <div class="sh-auth-fact">
                        <h2>Did you know?</h2>
                        <p>Every resource on ScholarHub is checked by a student admin before it goes live &mdash; so what you download is always the real thing.</p>
                    </div>
                </div>
                <div class="sh-auth-content">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; 2026 ScholarHub &middot; Academic resource sharing for students</span>
            <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>